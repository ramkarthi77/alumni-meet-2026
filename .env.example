# ─────────────────────────────────────────────────────────────────────────────
# Alumni Meet 2026 — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real credentials to Git.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL — Prisma connection string
# For local development use:  postgresql://USER:PASSWORD@localhost:5432/alumni_meet
# For Vercel Postgres use the connection string from the Vercel dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/alumni_meet?schema=public"

# Prisma accelerate / direct URL (required if using connection pooling via Vercel Postgres / Neon)
# Leave blank if not using a pooler.
DIRECT_URL=""

# NextAuth.js
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_SECURE_RANDOM_STRING"
NEXTAUTH_URL="http://localhost:3000"

# ─── Organizer bootstrap ───────────────────────────────────────────────────────
# Used ONCE by the seed script (npm run db:seed) to create the first organizer.
# Remove from environment after first run. Never use default passwords in prod.
ORGANIZER_BOOTSTRAP_EMAIL="organizer@example.com"
ORGANIZER_BOOTSTRAP_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"
ORGANIZER_BOOTSTRAP_NAME="Event Organizer"

# ─── Rate limiting (optional — defaults shown) ────────────────────────────────
# Max registration attempts per IP per 15-minute window
RATE_LIMIT_REGISTER_MAX="10"
# Max login attempts per IP per 15-minute window
RATE_LIMIT_LOGIN_MAX="5"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
