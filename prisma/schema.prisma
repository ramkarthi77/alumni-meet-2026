generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

// ─── Member ───────────────────────────────────────────────────────────────────
model Member {
  phoneNumber         String    @id @db.String(20)
  name                String    @db.String(200)
  classBatch          String    @db.String(100)
  group               String?   @db.String(10)
  numberOfAdults      Int       @default(1)
  numberOfKids        Int       @default(0)
  contributionAmount  Decimal   @default(0)
  email               String?   @db.String(255)
  spouseName          String?   @db.String(200)
  dateOfBirth         DateTime? @db.Timestamptz
  marriageAnniversary DateTime? @db.Timestamptz
  profession          String?   @db.String(200)
  createdAt           DateTime  @default(now()) @db.Timestamptz
  updatedAt           DateTime  @updatedAt @db.Timestamptz

  auditLogs AuditLog[]

  @@index([name])
  @@index([classBatch])
  @@index([contributionAmount])
  @@map("members")
}

// ─── Organizer ────────────────────────────────────────────────────────────────
model Organizer {
  id           String    @id @default(cuid())
  email        String    @unique @db.String(255)
  name         String    @db.String(200)
  passwordHash String    @db.String(255)
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz
  lastLoginAt  DateTime? @db.Timestamptz

  auditLogs AuditLog[]

  @@map("organizers")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────
model AuditLog {
  id            String   @id @default(cuid())
  organizerId   String
  action        String   @db.String(50)
  targetPhone   String   @db.String(20)
  changesBefore Json?
  changesAfter  Json?
  ipAddress     String?  @db.String(45)
  createdAt     DateTime @default(now()) @db.Timestamptz

  organizer Organizer @relation(fields: [organizerId], references: [id])
  member    Member    @relation(fields: [targetPhone], references: [phoneNumber])

  @@index([targetPhone])
  @@index([organizerId])
  @@map("audit_logs")
}
