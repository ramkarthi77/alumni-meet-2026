generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Member ───────────────────────────────────────────────────────────────────
model Member {
  phoneNumber         String    @id
  name                String   
  classBatch          String   
  group               String?  
  numberOfAdults      Int       @default(1)
  numberOfKids        Int       @default(0)
  contributionAmount  Decimal   @default(0)
  email               String?  
  spouseName          String?  
  dateOfBirth         DateTime? @db.Timestamptz
  marriageAnniversary DateTime? @db.Timestamptz
  profession          String?  
  createdAt           DateTime  @default(now()) @db.Timestamptz
  updatedAt           DateTime  @updatedAt @db.Timestamptz

  auditLogs AuditLog[]

  @@index([name])
  @@index([classBatch])
  @@index([contributionAmount])
  @@map("members")
}

// ─── Organizer ────────────────────────────────────────────────────────────────
model Organizer {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String   
  passwordHash String   
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz
  lastLoginAt  DateTime? @db.Timestamptz

  auditLogs AuditLog[]

  @@map("organizers")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────
model AuditLog {
  id            String   @id @default(cuid())
  organizerId   String
  action        String  
  targetPhone   String  
  changesBefore Json?
  changesAfter  Json?
  ipAddress     String? 
  createdAt     DateTime @default(now()) @db.Timestamptz

  organizer Organizer @relation(fields: [organizerId], references: [id])
  member    Member    @relation(fields: [targetPhone], references: [phoneNumber])

  @@index([targetPhone])
  @@index([organizerId])
  @@map("audit_logs")
}
